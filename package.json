{
  "name": "receipt-app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "TMPDIR=/tmp nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "seed": "node --env-file=.env --import tsx scripts/seed-recipes.ts",
    "seed:manual": "node --env-file=.env --import tsx scripts/seed-manual.ts",
    "clear:recipes": "node --env-file=.env --import tsx scripts/clear-recipes.ts",
    "gen:icons": "node --import tsx scripts/gen-icons.ts",
    "scrape:1000menu": "node --env-file=.env --import tsx scripts/scrape-1000menu.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@nuxtjs/supabase": "^2.0.9",
    "@pinia/nuxt": "^0.11.3",
    "@supabase/supabase-js": "^2.107.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "nuxt": "^4.4.7",
    "pinia": "^3.0.4",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp"
    ]
  }
}
